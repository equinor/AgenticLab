<header class="app-header">
    <a class="brand" href="/" aria-label="@($"{Title} home")">
        <span class="brand-mark" aria-hidden="true"><span></span></span>
        <h1>@Title</h1>
    </a>
    <div class="header-actions">
        <span class="edition">@Context <span>Blazor</span></span>
        @ChildContent
        <RepositoryLink />
    </div>
</header>

@code {
    /// <summary>The product heading and accessible name of the link to the front page.</summary>
    [Parameter] public string Title { get; set; } = "Agentic AI";
    /// <summary>A compact page identifier next to the implementation label.</summary>
    [Parameter, EditorRequired] public string Context { get; set; } = string.Empty;
    /// <summary>Page-specific links and actions, rendered inside the page's interactive boundary.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}