<section class="model-response" aria-label="Model response" data-diagram="model-response" data-beat="@_step" data-mode="@(IsToolCall ? "tool-call" : "answer")">
    <div class="response-toolbar" role="group" aria-label="Model response steps">
        <LabButton Label="Previous step" Icon="prev" IconOnly="true" Disabled="@(_step == 0)" OnClick="() => Move(-1)" />
        <span class="step-count">@(_step + 1) / 2</span>
        <LabButton Label="Next step" Icon="next" IconOnly="true" Disabled="@IsToolCall" OnClick="() => Move(1)" />
        <LabButton Label="Restart" Variant="quiet" Disabled="@(_step == 0)" OnClick="Restart" />
    </div>
    <h3 class="mode-heading" role="status" aria-live="polite">@(_step + 1). Model response is: <strong>@(IsToolCall ? "Tool Call" : "Answer")</strong></h3>
    @if (IsToolCall)
    {
        <p>The model requests actions that the harness should execute.</p>
    }
    <div class="response-diagram" role="group" aria-label="@(IsToolCall ? "Harness supplies context to the LLM, receives a tool-call request and invokes its example tool" : "Harness supplies context to the LLM and receives an answer")">
        <section class="response-box harness-box" data-node="harness">
            <h3><span class="response-icon harness-icon" aria-hidden="true"></span>Harness</h3>
            <p>Supplies context to the LLM.</p>
            @if (IsToolCall)
            {
                <p>Checks and invokes the requested tool.</p>
                <div class="tool-exchange" aria-hidden="true"><span>Call</span><span>&darr; &uarr;</span><span>Result</span></div>
                <div class="example-tool" data-node="example-tool">
                    <h4><span class="response-icon tool-icon" aria-hidden="true"></span>Web search tool</h4>
                    <p>Finds online information</p>
                </div>
                <p>Passes the result to context management for the next request in the loop.</p>
            }
            else
            {
                <p>Returns the answer to the user. No tool call is needed.</p>
            }
        </section>
        <div class="response-exchange" aria-hidden="true">
            <div class="context-path"><span>Context</span><span class="path-line"></span></div>
            <div class="model-path"><span class="path-line"></span><span>@(IsToolCall ? "Tool-call request" : "Answer")</span></div>
        </div>
        <section class="response-box model-box" data-node="model">
            <h3><span class="response-icon model-icon" aria-hidden="true"></span>LLM</h3>
            <p>Reasons over the supplied context and chooses the next action to fulfill each request.</p>
            @if (IsToolCall)
            {
                <p>Requests that the harness call a tool, specifying its name and arguments.</p>
                <p>The model does not execute the tool.</p>
            }
            else
            {
                <p>Here the model determines that it can answer directly, without requesting anything further from the harness.</p>
            }
        </section>
    </div>
</section>

@code {
    private int _step;
    private bool IsToolCall => _step == 1;

    /// <summary>Switches response step, returning false when navigation must cross a lesson boundary.</summary>
    public bool TryMoveStep(int direction)
    {
        var next = _step + direction;
        if (direction is not (-1 or 1) || next is < 0 or > 1) return false;
        _step = next;
        StateHasChanged();
        return true;
    }

    /// <summary>Shows the tool-call step when entering from the following lesson.</summary>
    public void MoveToLastStep()
    {
        _step = 1;
        StateHasChanged();
    }

    private void Move(int direction) => TryMoveStep(direction);
    private void Restart() => _step = 0;
}