@using AgenticLab.Web.Learning

<section class="turn-lesson" aria-label="Explore the agent loop" data-diagram="loop" data-beat="@_story.Beat">
    <div class="turn-toolbar" role="group" aria-label="Turn steps">
        <LabButton Label="Previous step" Icon="prev" IconOnly="true" Disabled="@(!_story.CanPrevious)" OnClick="() => _story.Move(-1)" />
        <span class="step-count">@(_story.Beat + 1) / @AgentLoopStory.Steps.Count</span>
        <LabButton Label="Next step" Icon="next" IconOnly="true" Disabled="@(!_story.CanNext)" OnClick="() => _story.Move(1)" />
        <LabButton Label="Show all steps" Icon="expand" Disabled="@_story.ShowAll" OnClick="_story.Complete" />
        <LabButton Label="Restart" Variant="quiet" Disabled="@(_story.Beat == 0)" OnClick="_story.Restart" />
    </div>
    <p class="loop-introduction">One turn can contain several model requests. The harness carries information between them and decides when execution continues or ends.</p>
    <div class="turn-loop" role="group" aria-label="Agent loop: context management to model to execution, then back to context management or a response or stop">
        @foreach (var node in LoopNodes)
        {
            var reached = AgentLoopStory.Steps.Take(_story.Beat + 1).LastOrDefault(step => step.Id == node.Id);
            <section class="loop-node loop-@node.Id @(reached is null ? "pending" : "reached")"
                     data-loop-node="@node.Id" aria-current="@(_story.Step.Id == node.Id ? "step" : null)">
                <h3><span class="loop-icon @node.Icon" aria-hidden="true"></span>@node.Title</h3>
                @if (reached is not null)
                {
                    <div class="node-detail">
                        <small>@(node.Id == "model" ? "Model" : "Harness")</small>
                        <p>@reached.Title</p>
                    </div>
                }
            </section>
        }
        <span class="loop-edge context-edge @(_story.Beat >= 1 ? "traversed" : null)" aria-hidden="true"><span>Request</span></span>
        <span class="loop-edge tool-edge @(_story.Beat >= 2 ? "traversed" : null)" aria-hidden="true"><span>Response</span></span>
        <span class="loop-edge answer-edge @(_story.Beat >= 5 ? "traversed" : null)" aria-hidden="true"></span>
        <span class="return-edge @(_story.Beat >= 4 ? "traversed" : null)" aria-hidden="true"><span>Results into next context</span></span>
    </div>
    <div class="turn-evidence" aria-live="polite" aria-atomic="true">
        @foreach (var step in _story.ShowAll ? AgentLoopStory.Steps : new[] { _story.Step })
        {
            <section class="step-evidence" data-step="@step.Id">
                <h3>@step.Title</h3>
                <p>@step.Detail</p>
            </section>
        }
    </div>
    <p class="loop-note">Tool results return through context management. Responses and stops leave through execution. These are responsibilities, not a view of the model's internal reasoning.</p>
</section>

@code {
    private readonly AgentLoopStory _story = new();

    /// <summary>Moves one step, returning false when the page must navigate to another lesson.</summary>
    public bool TryMoveStep(int direction)
    {
        if (!(direction == -1 ? _story.CanPrevious : direction == 1 && _story.CanNext)) return false;
        _story.Move(direction);
        StateHasChanged();
        return true;
    }

    /// <summary>Enters the final step without expanding the full sequence of explanations.</summary>
    public void MoveToLastStep()
    {
        _story.Move(int.MaxValue);
        StateHasChanged();
    }

    private static readonly (string Id, string Title, string Icon)[] LoopNodes =
    [
        ("context", "Context management", "workflow-icon"),
        ("model", "Model", "model-icon"),
        ("execute", "Execution", "workflow-icon"),
        ("answer", "Response or stop", "workflow-icon"),
    ];

}