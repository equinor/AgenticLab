@page "/"

<PageTitle>Agentic Lab</PageTitle>

<div class="home-app">
    <AppHeader Title="Agentic Lab" Context="Home" />

    <main class="home-main">
        <div class="home-content">
            <h2 class="home-title">Agentic Lab</h2>
            <nav class="destinations" aria-label="Agentic Lab destinations">
                <a class="destination" href="/flow">
                    <span class="destination-icon flow-icon" aria-hidden="true"></span>
                    <span class="destination-name">Live flow</span>
                    <span class="destination-arrow" aria-hidden="true">&rarr;</span>
                </a>
                <a class="destination" href="/learn">
                    <span class="destination-icon guide-icon" aria-hidden="true"></span>
                    <span class="destination-name">Agent guide</span>
                    <span class="destination-arrow" aria-hidden="true">&rarr;</span>
                </a>
            </nav>
        </div>
    </main>
</div>