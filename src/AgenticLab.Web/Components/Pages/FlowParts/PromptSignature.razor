@* The "prompt signature" panel (Prompt signature toggle): the most recent LLM request broken
   down by message category as a stacked bar, compared against the previous request, with a prefix-
   stability "match" score. Mirrors the harness anatomy's contributor framing — it shows what the model
   actually received this round-trip and how much of it was reused from the last one. *@

<div class="prompt-signature @(Run.Replay.Replaying ? "replay" : null) @(Sig.HasTokens ? "has-tokens" : null) @(Sig.HasCachedTokens ? "has-cached" : null)">
    <div class="sig-head">
        <span class="sig-title-group">
            <ConceptInfoButton Id="prompt-signature" Title="Learn about the prompt signature" />
            <span class="sig-title">Prompt signature</span>
        </span>
        <div class="sig-mode-toggle" role="group" aria-label="Prompt signature view">
            <button type="button" class="@(View.Diagram.PromptSignatureDelta ? null : "is-active")"
                    @onclick="@(() => View.Diagram.PromptSignatureDelta = false)">Comparison</button>
            <button type="button" class="@(View.Diagram.PromptSignatureDelta ? "is-active" : null)"
                    @onclick="@(() => View.Diagram.PromptSignatureDelta = true)">Delta</button>
        </div>
    </div>

    @if (Run.Replay.Replaying)
    {
        <div class="sig-position">
            <span class="sig-replay-mode">Replay · exchange @(Run.Replay.SelectedExchange?.Number)</span>
            @if (Run.Replay.SelectedStage is { } stage)
            {
                <span>@(stage.Turn > 0 ? $"T{stage.Turn} · " : null)@ExecutionReplayBuilder.StageTitle(stage)</span>
            }
        </div>
    }

    @if (!Sig.HasCurrent)
    {
        <span class="sig-empty">@(Run.Replay.Replaying ? "No request captured at this stage." : "the signature appears once the agent sends its first request…")</span>
    }
    else if (View.Diagram.PromptSignatureDelta)
    {
        <ul class="sig-legend">
            <li><span class="sig-swatch sig-reused"></span><span class="sig-legend-label">Reused (carried over)</span></li>
            <li><span class="sig-swatch sig-added"></span><span class="sig-legend-label">Added this exchange</span></li>
        </ul>

        <div class="sig-delta">
            @foreach (var request in Sig.Requests)
            {
                @DeltaBar(request, Sig.MaxRequestChars)
            }
        </div>
        <span class="sig-sub sig-delta-caption">one bar per conversation exchange — each turn carries the previous prompt forward and adds its own</span>
    }
    else
    {
        <ul class="sig-legend">
            @foreach (var category in Sig.Current)
            {
                var percent = Sig.CurrentChars > 0 ? category.Chars * 100.0 / Sig.CurrentChars : 0;
                <li class="@(category.Chars == 0 ? "is-zero" : null)" title="@category.Label: @category.Chars.ToString("N0") chars (@percent.ToString("0.#")% of the request)">
                    <span class="sig-swatch sig-@category.Key"></span>
                    <span class="sig-legend-label">@category.Label</span>
                    <span class="sig-legend-num">@category.Chars.ToString("N0")</span>
                </li>
            }
        </ul>

        @if (Sig.HasPrevious)
        {
            <span class="sig-sub sig-compare-caption">
                comparing two conversation exchanges — previous (<span class="sig-conv" title="@PreviousLabel">@Short(PreviousLabel)</span>) vs current (<span class="sig-conv" title="@CurrentLabel">@Short(CurrentLabel)</span>)
            </span>
            @Bar("Previous", Sig.Previous, Sig.PreviousChars, PreviousLabel, Sig.PreviousRequest?.Tokens)
        }
        @Bar("Current", Sig.Current, Sig.CurrentChars, CurrentLabel, Sig.CurrentRequest?.Tokens)

        @if (Sig.HasPrevious)
        {
            <div class="sig-row sig-match-row">
                <span class="sig-row-label">Match</span>
                <div class="sig-match" title="Share of the current exchange's prompt byte-identical to the previous one (reused prompt prefix)">
                    <span class="sig-match-fill" style="width:@(Sig.MatchPercent)%"></span>
                </div>
                <span class="sig-row-total">@(Sig.MatchPercent)% match</span>
            </div>
        }
        else
        {
            <span class="sig-hint">@(Run.Replay.Replaying ? "No earlier exchange with a captured request." : "send another message to compare against the previous conversation exchange…")</span>
        }
    }
</div>

@code {
    [CascadingParameter]
    private FlowRunController Run { get; set; } = default!;

    [CascadingParameter]
    private FlowViewState View { get; set; } = default!;

    private PromptSignatureView Sig => Run.Replay.DisplayPromptSignature;

    // The user messages of the two conversation exchanges being compared (current = newest, previous = before).
    private string CurrentLabel => Sig.CurrentRequest?.Label ?? string.Empty;
    private string PreviousLabel => Sig.PreviousRequest?.Label ?? string.Empty;

    private static string Short(string value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value.Length > 32 ? value[..31] + "…" : value;

    // Renders one labelled stacked bar: a segment per non-empty category sized by its char share, with
    // the char count shown inside wide-enough segments and the total at the right. The optional conversation
    // message is shown as the row's tooltip so it's clear which exchange the bar represents.
    private RenderFragment Bar(string label, IReadOnlyList<PromptSignatureCategory> categories, int total, string? conv = null, PromptSignatureTokens? tokens = null) => @<div class="sig-row" title="@(string.IsNullOrWhiteSpace(conv) ? null : $"{label} exchange: {conv}")">
        <span class="sig-row-label">@label</span>
        <div class="sig-bar">
            @if (total == 0)
            {
                <span class="sig-seg sig-empty-seg" style="width:100%"></span>
            }
            else
            {
                @foreach (var category in categories)
                {
                    if (category.Chars > 0)
                    {
                        var percent = category.Chars * 100.0 / total;
                        var width = percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                        <span class="sig-seg sig-@category.Key" style="width:@(width)%"
                              title="@category.Label: @category.Chars.ToString("N0") chars (@percent.ToString("0.#")%)">
                            @if (percent >= 12)
                            {
                                <span class="sig-seg-num">@category.Chars.ToString("N0")</span>
                            }
                        </span>
                    }
                }
            }
        </div>
        @Total(total, tokens)
    </div>;

    // A row's token line. The cached count sits inside the input it is part of, and only when reported.
    private static string TokensText(ModelCallUsage tokens) =>
        tokens.CachedInputTokens is { } cached
            ? $"{tokens.InputTokens:N0} in ({cached:N0} cached) · {tokens.OutputTokens:N0} out tokens"
            : $"{tokens.InputTokens:N0} in · {tokens.OutputTokens:N0} out tokens";

    // What the token line covers when it is not simply the exchange's only model call: the number of calls
    // summed for a delivered exchange, or the one model turn shown before delivery.
    private static string? TokensScope(PromptSignatureTokens tokens) =>
        tokens.Turn is { } turn ? $"turn {turn}" : tokens.ModelCalls > 1 ? $"{tokens.ModelCalls} calls" : null;

    // The exact counts behind a row's token line, what they cover, and why the input count is not a
    // conversion of the chars.
    private static string TokensTitle(PromptSignatureTokens tokens)
    {
        var usage = tokens.Usage;
        var covers = tokens.Turn is { } turn
            ? $"reported by the provider for model turn {turn} of this exchange alone. Input is that whole request, including the " +
              "tool catalogue and message framing that the character count leaves out. The delivered exchange shows the sum of all its model calls."
            : tokens.ModelCalls > 1
                ? $"the provider-reported sum of this exchange's {tokens.ModelCalls} model calls, as on the reply in the conversation. " +
                  "Every call sends the context so far again, so input counts it once per call, along with the tool catalogue and " +
                  "message framing that the character count leaves out. Select a model turn in Execution to see that call alone."
                : "reported by the provider for this exchange's model call. Input is the whole request, including the " +
                  "tool catalogue and message framing that the character count leaves out.";
        return $"{usage.InputTokens:N0} input + {usage.OutputTokens:N0} output = {usage.InputTokens + usage.OutputTokens:N0} tokens, " + covers +
            (usage.CachedInputTokens is { } cached
                ? $" {cached:N0} of the input tokens were read from the provider's prompt cache; unlike Match, this is measured reuse."
                : null);
    }

    // The right-hand total of a row: the character count, with the provider-reported tokens beneath it.
    // Providers that report no usage leave the chars on their own.
    private RenderFragment Total(int chars, PromptSignatureTokens? tokens) => @<span class="sig-row-total">
        @chars.ToString("N0") chars
        @if (tokens is not null)
        {
            <span class="sig-row-tokens" title="@TokensTitle(tokens)">@TokensText(tokens.Usage)@if (TokensScope(tokens) is { } scope){<span class="sig-row-scope"> · @scope</span>}</span>
        }
    </span>;

    // Renders one delta/waterfall row for a conversation exchange: an outer track scaled to the conversation's
    // largest exchange (so growth is visible), filled with a muted "carried over" segment plus a highlighted
    // "added this exchange" segment — so each turn visibly carries the previous prompt forward and adds its own.
    private RenderFragment DeltaBar(PromptSignatureRequest request, int max)
    {
        var trackPercent = max > 0 ? request.TotalChars * 100.0 / max : 0;
        var trackWidth = trackPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        var reusedPercent = request.TotalChars > 0 ? request.ReusedChars * 100.0 / request.TotalChars : 0;
        var reusedWidth = reusedPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        var addedWidth = (100 - reusedPercent).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        var label = string.IsNullOrWhiteSpace(request.Label) ? $"Exchange {request.Index}" : request.Label;
        return @<div class="sig-row sig-delta-row">
            <span class="sig-row-label" title="@label">@label</span>
            <div class="sig-delta-track">
                <div class="sig-bar sig-delta-bar" style="width:@(trackWidth)%"
                     title="Exchange @request.Index: @request.TotalChars.ToString("N0") chars (@request.ReusedChars.ToString("N0") reused + @request.AddedChars.ToString("N0") added)">
                    @if (request.ReusedChars > 0)
                    {
                        <span class="sig-seg sig-reused" style="width:@(reusedWidth)%"
                              title="Carried over: @request.ReusedChars.ToString("N0") chars"></span>
                    }
                    <span class="sig-seg sig-added" style="width:@(addedWidth)%"
                          title="Added this exchange: @request.AddedChars.ToString("N0") chars">
                        @if (100 - reusedPercent >= 14)
                        {
                            <span class="sig-seg-num">+@request.AddedChars.ToString("N0")</span>
                        }
                    </span>
                </div>
            </div>
            @Total(request.TotalChars, request.Tokens)
        </div>;
    }
}
